  "templates": [
    {
      "id": "tpl_reminder_en_formal",
      "kind": "payment_reminder",
      "language": "en",
      "tone": "formal",
      "body": "Dear {customer_name}, invoice {invoice_no} for {amount} was due on {due_date}. Could you confirm the payment date? {sender_name}, {company_name}",
      "placeholders": [
        "customer_name",
        "invoice_no",
        "amount",
        "due_date",
        "sender_name",
        "company_name"
      ],
      "status": "approved"
    },
    {
      "id": "tpl_reminder_ms_formal",
      "kind": "payment_reminder",
      "language": "ms",
      "tone": "formal",
      "body": "Tuan/Puan {customer_name}, invois {invoice_no} berjumlah {amount} telah tamat tempoh pada {due_date}. Mohon sahkan tarikh pembayaran. {sender_name}, {company_name}",
      "placeholders": [
        "customer_name",
        "invoice_no",
        "amount",
        "due_date",
        "sender_name",
        "company_name"
      ],
      "status": "approved"
    },
    {
      "id": "tpl_reminder_zh_friendly",
      "kind": "payment_reminder",
      "language": "zh",
      "tone": "friendly",
      "body": "{customer_name} 您好，发票 {invoice_no}（{amount}）已于 {due_date} 到期，请问预计何时付款？{sender_name}，{company_name}",
      "placeholders": [
        "customer_name",
        "invoice_no",
        "amount",
        "due_date",
        "sender_name",
        "company_name"
      ],
      "status": "draft"
    }
  ],
