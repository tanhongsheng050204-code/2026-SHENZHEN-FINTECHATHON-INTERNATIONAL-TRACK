# Local development
VITE_API_URL=http://localhost:8000

# Vercel deployment: VITE_API_URL=/api, and BACKEND_ORIGIN (a Vercel project
# variable read by api/proxy.js) set to the Cloud Run URL. The app and API then
# share one origin, which backend cookie sessions need.
# See docs/deployment/cloud-run-and-vercel.md.
VITE_SUPABASE_URL=https://PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Sign-in: "supabase" (default) signs in from the browser; "backend" uses the
# API-owned cookie session from Plan 2 (email code, authenticator app, step-up).
# The API must list this app's exact origin in CORS_ORIGINS for backend mode.
VITE_AUTH_MODE=supabase
