# Local development
VITE_API_URL=http://localhost:8000

# Vercel deployment: set VITE_API_URL to your Railway backend URL, e.g.
# VITE_API_URL=https://finbrain-backend.up.railway.app
VITE_SUPABASE_URL=https://PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Sign-in: "supabase" (default) signs in from the browser; "backend" uses the
# API-owned cookie session from Plan 2 (email code, authenticator app, step-up).
# The API must list this app's exact origin in CORS_ORIGINS for backend mode.
VITE_AUTH_MODE=supabase
