  "components": {
    "schemas": {
      "AlertRule": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "metric": {
            "type": "string",
            "enum": [
              "projected_balance",
              "overdue_amount_per_customer",
              "stock_below_reorder",
              "payroll_coverage_days",
              "marketing_return_per_ringgit",
              "open_disputes"
            ],
            "title": "Metric"
          },
          "operator": {
            "type": "string",
            "enum": [
              "above",
              "below"
            ],
            "title": "Operator"
          },
          "threshold": {
            "type": "string",
            "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
            "title": "Threshold"
          },
          "recipients": {
            "items": {
              "$ref": "#/components/schemas/JobFunction"
            },
            "type": "array",
            "title": "Recipients"
          },
          "channel": {
            "type": "string",
            "enum": [
              "in_app",
              "email",
              "telegram"
            ],
            "title": "Channel"
          },
          "enabled": {
            "type": "boolean",
            "title": "Enabled"
          }
        },
        "type": "object",
        "required": [
          "id",
          "metric",
          "operator",
          "threshold",
          "recipients",
          "channel",
          "enabled"
        ],
        "title": "AlertRule"
      },
      "AlertRuleRequest": {
        "properties": {
          "metric": {
            "type": "string",
            "enum": [
              "projected_balance",
              "overdue_amount_per_customer",
              "stock_below_reorder",
              "payroll_coverage_days",
              "marketing_return_per_ringgit",
              "open_disputes"
            ],
            "title": "Metric"
          },
          "operator": {
            "type": "string",
            "enum": [
              "above",
              "below"
            ],
            "title": "Operator"
          },
          "threshold": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0.0
              },
              {
                "type": "string",
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$"
              }
            ],
            "title": "Threshold"
          },
          "recipients": {
            "items": {
              "$ref": "#/components/schemas/JobFunction"
            },
            "type": "array",
            "maxItems": 11,
            "minItems": 1,
            "title": "Recipients"
          },
          "channel": {
            "type": "string",
            "enum": [
              "in_app",
              "email",
              "telegram"
            ],
            "title": "Channel"
          }
        },
        "type": "object",
        "required": [
          "metric",
          "operator",
          "threshold",
          "recipients",
          "channel"
        ],
        "title": "AlertRuleRequest"
      },
      "AlertRuleResponse": {
        "properties": {
          "data_mode": {
            "$ref": "#/components/schemas/DataMode"
